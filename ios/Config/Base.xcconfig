// Base build settings for delts.
//
// To enable Gemini locally:
// 1. Copy ios/Secrets.example.xcconfig to ios/Secrets.xcconfig.
// 2. Put your key in the ignored file:
//    GEMINI_API_KEY = your_gemini_api_key_here
// 3. Rebuild the app. The key is mapped into Info.plist as GEMINI_API_KEY.
//
// If this value is empty or missing, the app uses offline mock workout generation.
GEMINI_API_KEY =
#include? "../Secrets.xcconfig"
INFOPLIST_KEY_GEMINI_API_KEY = $(GEMINI_API_KEY)

