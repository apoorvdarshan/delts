    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم DELTS الكاميرا لتتمكن من إرفاق صورة بمحادثة المدرّب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS kameradan Məşqçi söhbətinə foto əlavə edə bilməyiniz üçün istifadə edir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS nutzt die Kamera, damit du dem Coach-Chat ein Foto anhängen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS uses the camera so you can attach a photo to the Coach chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS usa la cámara para que puedas adjuntar una foto al chat del Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS utilise l’appareil photo pour que vous puissiez joindre une photo au chat du Coach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS कैमरे का उपयोग करता है ताकि आप कोच चैट में फ़ोटो जोड़ सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS usa la fotocamera per permetterti di allegare una foto alla chat del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSは、コーチチャットに写真を添付するためにカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 코치 채팅에 사진을 첨부할 수 있도록 카메라를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS gebruikt de camera zodat je een foto aan de Coach-chat kunt toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS używa aparatu, aby umożliwić dołączenie zdjęcia do czatu z Trenerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS usa a câmera para você anexar uma foto ao chat do Coach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS folosește camera ca să poți atașa o poză în chatul cu Antrenorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS использует камеру, чтобы вы могли прикрепить фото к чату с Тренером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 使用相机，以便你在教练聊天中附上照片。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ DELTS سجلّ وزن الجسم ونسبة دهون الجسم لعرض مخططات التقدّم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS irəliləyiş qrafiklərini göstərmək üçün bədən çəkisi və bədən yağı tarixçəsini oxuyur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS liest den Verlauf von Körpergewicht und Körperfett, um Fortschrittsdiagramme anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS reads body weight and body fat history to show progress charts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS lee tu historial de peso y grasa corporal para mostrar gráficas de progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS lit l’historique de poids et de masse grasse pour afficher vos courbes de progression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS प्रगति चार्ट दिखाने के लिए शरीर के वज़न और बॉडी फैट का इतिहास पढ़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS legge lo storico di peso e massa grassa per mostrare i grafici dei progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSは、進捗グラフを表示するために体重と体脂肪の履歴を読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 진행 차트를 표시하기 위해 체중 및 체지방 기록을 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS leest je gewichts- en vetpercentagegeschiedenis om voortgangsgrafieken te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS odczytuje historię masy ciała i tkanki tłuszczowej, aby pokazywać wykresy postępów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS lê o histórico de peso e gordura corporal para mostrar gráficos de progresso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS citește istoricul greutății și al grăsimii corporale pentru a afișa grafice de progres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS читает историю веса и процента жира, чтобы показывать графики прогресса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 读取体重和体脂历史，用于显示进度图表。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل DELTS قياسات وزن الجسم ونسبة الدهون التي تُدخلها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS daxil etdiyiniz bədən çəkisi və bədən yağı qeydlərini yazır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS speichert die von dir eingegebenen Körpergewichts- und Körperfettwerte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS writes body weight and body fat logs you enter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS guarda los registros de peso y grasa corporal que introduces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS enregistre les mesures de poids et de masse grasse que vous saisissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS आपके दर्ज किए गए वज़न और बॉडी फैट लॉग सेव करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS salva i dati di peso e massa grassa che inserisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSは、入力された体重と体脂肪の記録を書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 입력한 체중 및 체지방 기록을 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS slaat de gewichts- en vetpercentagelogs op die je invoert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS zapisuje wprowadzone przez Ciebie pomiary masy ciała i tkanki tłuszczowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS grava os registros de peso e gordura corporal que você insere."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS salvează înregistrările de greutate și grăsime corporală pe care le introduci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS записывает введённые вами данные о весе и проценте жира."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 写入你输入的体重和体脂记录。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك DELTS إرفاق صورة من مكتبتك بمحادثة المدرّب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS kitabxananızdan Məşqçi söhbətinə foto əlavə etməyə imkan verir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit DELTS kannst du dem Coach-Chat ein Foto aus deiner Mediathek anhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS lets you attach a photo from your library to the Coach chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS te permite adjuntar una foto de tu biblioteca al chat del Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS vous permet de joindre une photo de votre photothèque au chat du Coach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS आपको अपनी लाइब्रेरी से कोच चैट में फ़ोटो जोड़ने देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS ti permette di allegare una foto dalla libreria alla chat del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSでは、ライブラリの写真をコーチチャットに添付できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS에서 보관함의 사진을 코치 채팅에 첨부할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met DELTS kun je een foto uit je bibliotheek aan de Coach-chat toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS pozwala dołączyć zdjęcie z biblioteki do czatu z Trenerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS permite anexar uma foto da sua biblioteca ao chat do Coach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS îți permite să atașezi o poză din bibliotecă în chatul cu Antrenorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS позволяет прикрепить фото из медиатеки к чату с Тренером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 允许你从照片图库选择照片，附加到教练聊天。"
