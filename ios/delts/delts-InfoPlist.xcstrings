    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم DELTS الكاميرا لتتمكن من إرفاق صورة في محادثة المدرب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS kameradan Məşqçi söhbətinə şəkil əlavə etməyiniz üçün istifadə edir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS nutzt die Kamera, damit du ein Foto an den Coach-Chat anhängen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS uses the camera so you can attach a photo to the Coach chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS usa la cámara para que puedas adjuntar una foto al chat del Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS utilise l’appareil photo pour vous permettre de joindre une photo au chat du Coach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS कैमरे का उपयोग करता है ताकि आप कोच चैट में फ़ोटो जोड़ सकें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS usa la fotocamera per permetterti di allegare una foto alla chat del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSはコーチチャットに写真を添付できるよう、カメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 코치 채팅에 사진을 첨부할 수 있도록 카메라를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS gebruikt de camera zodat je een foto aan de Coach-chat kunt toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS używa aparatu, aby można było dołączyć zdjęcie do czatu z Trenerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS usa a câmera para você anexar uma foto ao chat do Coach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS folosește camera ca să poți atașa o poză în conversația cu Antrenorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS использует камеру, чтобы вы могли прикрепить фото в чат с тренером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 使用相机，以便你在教练聊天中附加照片。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ DELTS سجلّ وزن الجسم ودهون الجسم لعرض مخططات التقدّم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS tərəqqi qrafiklərini göstərmək üçün bədən çəkisi və bədən yağı tarixçəsini oxuyur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS liest den Verlauf von Körpergewicht und Körperfett, um Fortschrittsdiagramme anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS reads body weight and body fat history to show progress charts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS lee el historial de peso y grasa corporal para mostrar gráficas de progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS lit l’historique de poids et de masse grasse pour afficher les graphiques de progression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS प्रोग्रेस चार्ट दिखाने के लिए शरीर के वज़न और बॉडी फ़ैट की हिस्ट्री पढ़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS legge lo storico di peso e massa grassa per mostrare i grafici dei progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSは進捗グラフを表示するため、体重と体脂肪率の履歴を読み取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 진행 상황 차트를 표시하기 위해 체중과 체지방 기록을 읽습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS leest je gewichts- en vetpercentagegeschiedenis om voortgangsgrafieken te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS odczytuje historię masy ciała i tkanki tłuszczowej, aby pokazywać wykresy postępów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS lê o histórico de peso e gordura corporal para mostrar gráficos de progresso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS citește istoricul greutății și al grăsimii corporale pentru a afișa grafice de progres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS читает историю веса и процента жира, чтобы показывать графики прогресса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 读取体重和体脂历史以显示进度图表。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل DELTS قياسات وزن الجسم ودهون الجسم التي تدخلها."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS daxil etdiyiniz bədən çəkisi və bədən yağı qeydlərini yazır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS speichert von dir eingetragene Körpergewicht- und Körperfett-Logs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS writes body weight and body fat logs you enter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS escribe los registros de peso y grasa corporal que introduces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS écrit les poids et taux de masse grasse que vous saisissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS आपके दर्ज किए वज़न और बॉडी फ़ैट लॉग रिकॉर्ड करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS scrive i dati di peso e massa grassa che inserisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSは入力された体重・体脂肪率の記録を書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 사용자가 입력한 체중과 체지방 기록을 저장합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS schrijft de gewichts- en vetpercentagelogs weg die je invoert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS zapisuje wprowadzone przez Ciebie pomiary masy ciała i tkanki tłuszczowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS grava os registros de peso e gordura corporal que você insere."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS salvează înregistrările de greutate și grăsime corporală pe care le introduci."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS записывает введённые вами значения веса и процента жира."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 写入你输入的体重和体脂记录。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتيح لك DELTS إرفاق صورة من مكتبتك في محادثة المدرب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS kitabxananızdan Məşqçi söhbətinə şəkil əlavə etməyə imkan verir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit DELTS kannst du ein Foto aus deiner Mediathek an den Coach-Chat anhängen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DELTS lets you attach a photo from your library to the Coach chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS te permite adjuntar una foto de tu fototeca al chat del Coach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS vous permet de joindre une photo de votre photothèque au chat du Coach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS आपको अपनी लाइब्रेरी से कोच चैट में फ़ोटो जोड़ने देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS ti consente di allegare una foto dalla tua libreria alla chat del Coach."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTSはライブラリの写真をコーチチャットに添付できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS는 보관함의 사진을 코치 채팅에 첨부할 수 있도록 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met DELTS kun je een foto uit je bibliotheek aan de Coach-chat toevoegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS pozwala dołączyć zdjęcie z biblioteki do czatu z Trenerem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DELTS permite anexar uma foto da sua fototeca ao chat do Coach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS îți permite să atașezi o poză din bibliotecă în conversația cu Antrenorul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS позволяет прикрепить фото из медиатеки в чат с тренером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DELTS 让你从照片图库中选取照片附加到教练聊天。"
          }
        }
