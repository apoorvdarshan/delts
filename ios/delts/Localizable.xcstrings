    "Stop or discard the %@ timer before starting another." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف مؤقّت %@ أو تجاهله قبل بدء مؤقّت آخر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenisini başlatmazdan əvvəl %@ taymerini dayandırın və ya imtina edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppe oder verwirf den %@-Timer, bevor du einen neuen startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén o descarta el temporizador de %@ antes de iniciar otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez ou abandonnez le minuteur de %@ avant d’en lancer un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरा टाइमर शुरू करने से पहले %@ टाइमर रोकें या हटा दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma o scarta il timer di %@ prima di avviarne un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のタイマーを開始するには、%@のタイマーを停止または破棄してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 타이머를 시작하기 전에 %@ 타이머를 중지하거나 버리세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de %@-timer of gooi hem weg voordat je een nieuwe start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymaj lub odrzuć stoper %@, zanim uruchomisz kolejny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare ou descarte o timer de %@ antes de iniciar outro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprește sau renunță la cronometrul %@ înainte de a porni altul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановите или сбросьте таймер «%@», прежде чем запускать новый."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始新计时前，请先停止或放弃%@的计时器。"
