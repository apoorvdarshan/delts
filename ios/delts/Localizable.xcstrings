    "Everything local stays free. Premium unlocks the AI that knows your training." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما هو محلي يبقى مجانيًا. يفتح Premium الذكاء الاصطناعي الذي يعرف تدريبك."
          }
        },
