    "Loving the red button? Tell the App Store." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعجبك الزر الأحمر؟ أخبر App Store."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qırmızı düymə xoşunuza gəlir? App Store-da bildirin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liebst du den roten Button? Sag es dem App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te encanta el botón rojo? Cuéntalo en el App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan du bouton rouge ? Dites-le sur l’App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाल बटन पसंद आया? App Store पर बताएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ami il pulsante rosso? Dillo sull'App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赤いボタンが気に入ったら、App Storeで教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨간 버튼이 마음에 드나요? App Store에 알려주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan van de rode knop? Laat het de App Store weten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podoba Ci się czerwony przycisk? Powiedz o tym w App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Curtindo o botão vermelho? Conte na App Store."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți place butonul roșu? Spune-o în App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нравится красная кнопка? Расскажите в App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "爱上红色按钮了？去 App Store 告诉大家吧。"
          }
        }
      }
    },
