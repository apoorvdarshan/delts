    "The Delts server (delts.fit) and Google's Gemini API (Google LLC), which generates the response. Your data is not sold and is not used for advertising." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خادم Delts (delts.fit) وواجهة Gemini API من Google (Google LLC)، التي تُنشئ الرد. لا تُباع بياناتك ولا تُستخدم في الإعلانات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts serveri (delts.fit) və cavabı yaradan Google-un Gemini API-si (Google LLC). Məlumatlarınız satılmır və reklam üçün istifadə olunmur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Delts-Server (delts.fit) und Googles Gemini-API (Google LLC), die die Antwort generiert. Deine Daten werden nicht verkauft und nicht für Werbung verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
