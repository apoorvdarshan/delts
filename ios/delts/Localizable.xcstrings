    "A gym app built around the red session timer. Set up your profile so plans, progress, and calorie estimates fit you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق جيم مبني حول مؤقّت الجلسة الأحمر. جهّز ملفك الشخصي لتناسبك الخطط والتقدّم وتقديرات السعرات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qırmızı sessiya taymeri ətrafında qurulmuş zal tətbiqi. Planlar, irəliləyiş və kalori hesablamaları sizə uyğun olsun deyə profilinizi qurun."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gym-App rund um den roten Session-Timer. Richte dein Profil ein, damit Pläne, Fortschritt und Kalorienschätzungen zu dir passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app de gimnasio centrada en el temporizador rojo de sesión. Configura tu perfil para que planes, progreso y calorías estimadas se ajusten a ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app de muscu construite autour du minuteur de séance rouge. Configurez votre profil pour que plans, progression et estimations de calories vous correspondent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रेड सेशन टाइमर पर बना एक जिम ऐप। अपनी प्रोफ़ाइल सेट करें ताकि प्लान, प्रगति और कैलोरी अनुमान आपके हिसाब से हों।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'app da palestra costruita attorno al timer rosso di sessione. Configura il tuo profilo: scheda, progressi e stime delle calorie saranno su misura per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "赤いセッションタイマーを中心に作られたジムアプリ。プロフィールを設定して、プラン・進捗・消費カロリーの推定を自分に合わせましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빨간 세션 타이머 중심의 헬스 앱. 프로필을 설정하면 플랜, 진행 상황, 칼로리 추정이 나에게 맞춰집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gym-app gebouwd rond de rode sessietimer. Stel je profiel in zodat schema's, voortgang en calorieschattingen bij jou passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja na siłownię zbudowana wokół czerwonego timera sesji. Uzupełnij profil, aby plany, postępy i szacunki kalorii pasowały do Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um app de academia criado em torno do timer vermelho de sessão. Configure seu perfil para planos, progresso e estimativas de calorias sob medida para você."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicație de sală construită în jurul cronometrului roșu de sesiune. Configurează-ți profilul ca planurile, progresul și estimările de calorii să ți se potrivească."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение для зала, построенное вокруг красного таймера тренировки. Настройте профиль, чтобы планы, прогресс и расчёт калорий подходили именно вам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一款以红色训练计时器为核心的健身应用。设置好个人资料，让计划、进度和卡路里估算更贴合你。"
          }
        }
      }
    },
