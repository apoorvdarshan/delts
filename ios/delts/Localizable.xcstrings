          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 타이머를 시작하기 전에 %@ 타이머를 중단하거나 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
