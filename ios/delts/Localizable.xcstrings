    "Reset filters or search a different body part, machine, or exercise." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تعيين عوامل التصفية أو ابحث عن منطقة جسم أو جهاز أو تمرين آخر."
