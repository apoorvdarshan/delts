    "Delts is not medical advice — consult a professional before changing your training." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts ليس نصيحة طبية — استشر مختصًا قبل تغيير تدريبك."
          }
