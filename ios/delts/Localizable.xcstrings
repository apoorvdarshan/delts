    "Subscriptions aren't available right now. Try again later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاشتراكات غير متاحة حاليًا. حاول مرة أخرى لاحقًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abunəliklər hazırda əlçatan deyil. Sonra yenidən cəhd edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos sind gerade nicht verfügbar. Versuch es später erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones no están disponibles ahora mismo. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements ne sont pas disponibles pour le moment. Réessayez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्सक्रिप्शन अभी उपलब्ध नहीं हैं। बाद में फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti non sono disponibili al momento. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在サブスクリプションを利用できません。後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 구독을 이용할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen zijn momenteel niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje są teraz niedostępne. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas não estão disponíveis no momento. Tente novamente mais tarde."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonamentele nu sunt disponibile momentan. Încearcă din nou mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки сейчас недоступны. Повторите попытку позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅暂不可用，请稍后再试。"
          }
        }
      }
    },
    "Subscriptions auto-renew until cancelled. Manage or cancel anytime in your App Store account settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجدّد الاشتراكات تلقائيًا حتى الإلغاء. يمكنك إدارتها أو إلغاؤها في أي وقت من إعدادات حسابك في App Store."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abunəliklər ləğv edilənədək avtomatik yenilənir. İstənilən vaxt App Store hesab tənzimləmələrindən idarə edin və ya ləğv edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch bis zur Kündigung. Verwalte oder kündige sie jederzeit in deinen App Store-Kontoeinstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta que las canceles. Gestiónalas o cancélalas cuando quieras en los ajustes de tu cuenta del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement jusqu’à résiliation. Gérez ou annulez à tout moment dans les réglages de votre compte App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्सक्रिप्शन रद्द होने तक अपने आप रिन्यू होते हैं। App Store अकाउंट सेटिंग्स में कभी भी मैनेज या रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente fino alla disdetta. Gestisci o annulla quando vuoi nelle impostazioni del tuo account App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは解約するまで自動更新されます。App Storeのアカウント設定からいつでも管理・解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 해지 전까지 자동 갱신됩니다. App Store 계정 설정에서 언제든지 관리하거나 해지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen verlengen automatisch tot je opzegt. Beheer of zeg op via je App Store-accountinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie do czasu anulowania. Zarządzaj nimi lub anuluj w ustawieniach konta App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas se renovam automaticamente até serem canceladas. Gerencie ou cancele quando quiser nos ajustes da sua conta na App Store."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonamentele se reînnoiesc automat până la anulare. Gestionează sau anulează oricând din setările contului tău App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка продлевается автоматически до отмены. Управлять ею или отменить можно в настройках учётной записи App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将自动续订，直至取消。可随时在 App Store 账户设置中管理或取消。"
          }
        }
      }
    },
