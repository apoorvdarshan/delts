    "Delts is not medical advice — consult a professional before changing your training." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts ليس نصيحة طبية — استشر مختصًا قبل تغيير برنامج تدريبك."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts tibbi məsləhət deyil — məşqinizi dəyişməzdən əvvəl mütəxəssislə məsləhətləşin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts ist keine medizinische Beratung — sprich mit Fachpersonal, bevor du dein Training änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts no es consejo médico: consulta a un profesional antes de cambiar tu entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts ne remplace pas un avis médical — consultez un professionnel avant de modifier votre entraînement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts चिकित्सकीय सलाह नहीं है — ट्रेनिंग बदलने से पहले किसी विशेषज्ञ से सलाह लें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts non fornisce consigli medici — consulta un professionista prima di modificare il tuo allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deltsは医療アドバイスではありません。トレーニングを変更する前に専門家にご相談ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts는 의학적 조언이 아닙니다 — 운동을 바꾸기 전에 전문가와 상담하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts is geen medisch advies — raadpleeg een professional voordat je je training aanpast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delts nie stanowi porady medycznej — przed zmianą treningu skonsultuj się ze specjalistą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Delts não é aconselhamento médico — consulte um profissional antes de mudar seu treino."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
