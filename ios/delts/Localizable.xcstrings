    "Mix compound strength days with accessory hypertrophy work." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امزج أيام القوة المركّبة مع تمارين التضخيم المساعدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompleks güc günlərini köməkçi hipertrofiya işi ilə birləşdirin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kombiniere Krafttage mit Grundübungen und ergänzender Hypertrophie-Arbeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combina días de fuerza compuestos con trabajo accesorio de hipertrofia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mêlez jours de force polyarticulaire et travail d’hypertrophie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंपाउंड स्ट्रेंथ दिनों के साथ एक्सेसरी हाइपरट्रॉफ़ी काम मिलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna giorni di forza sui fondamentali e lavoro accessorio di ipertrofia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパウンドの筋力の日と補助種目の筋肥大トレを組み合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복합 스트렝스 데이에 보조 근비대 운동을 섞습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combineer compound-krachtdagen met aanvullend hypertrofiewerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Łącz dni siłowe na bojach z pracą akcesoryjną na hipertrofię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misture dias de força com compostos e trabalho acessório de hipertrofia."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combină zile de forță compuse cu lucru accesoriu de hipertrofie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сочетайте базовые силовые дни с подсобной работой на гипертрофию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将复合力量日与辅助增肌训练相结合。"
          }
        }
      }
    },
