    "Classic endurance scale tied to breathing, fatigue, and heart rate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقياس تحمّل كلاسيكي مرتبط بالتنفس والتعب ومعدل نبض القلب."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tənəffüs, yorğunluq və ürək döyüntüsünə bağlı klassik dözümlülük şkalası."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klassische Ausdauerskala auf Basis von Atmung, Ermüdung und Puls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
