    "Finish a session with the timer on Home and it shows here with time taken and calories burned." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ جلسة بالمؤقّت في الرئيسية وستظهر هنا مع الوقت المستغرق والسعرات المحروقة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əsas səhifədəki taymerlə seansı bitirin — burada sərf olunan vaxt və yanan kalori ilə görünəcək."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende eine Einheit mit dem Timer im Start-Tab — sie erscheint hier mit Dauer und verbrannten Kalorien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una sesión con el temporizador en Inicio y aparecerá aquí con el tiempo empleado y las calorías quemadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez une séance avec le minuteur de l’Accueil : elle apparaîtra ici avec la durée et les calories brûlées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "होम पर टाइमर से सेशन पूरा करें — वह यहाँ लगे समय और बर्न हुई कैलोरी के साथ दिखेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina una sessione con il timer nella Home e comparirà qui con durata e calorie bruciate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームのタイマーでセッションを終えると、所要時間と消費カロリーがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈에서 타이머로 세션을 마치면 소요 시간과 소모 칼로리가 여기에 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rond een sessie af met de timer op Home en die verschijnt hier met tijdsduur en verbrande calorieën."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ sesję ze stoperem na karcie Start, a pojawi się tutaj z czasem trwania i spalonymi kaloriami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
