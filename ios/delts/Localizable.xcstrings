    "Auto-renews until cancelled. Cancel anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدّد تلقائيًا حتى الإلغاء. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ləğv edilənədək avtomatik yenilənir. İstənilən vaxt Tənzimləmələrdən ləğv edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente hasta que la canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique jusqu’à résiliation. Annulable à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रद्द होने तक अपने आप रिन्यू होता है। सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente fino alla disdetta. Annulla quando vuoi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解約するまで自動更新されます。設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해지 전까지 자동 갱신됩니다. 설정에서 언제든지 해지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlengt automatisch tot je opzegt. Opzeggen kan altijd via Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odnawia się automatycznie do czasu anulowania. Anuluj w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
