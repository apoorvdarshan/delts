    "Chat about training, form, and nutrition — it sees your real data" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دردش حول التدريب والأداء والتغذية — فهو يطّلع على بياناتك الفعلية"
          }
        },
        "az" : {
          "stringUnit" : {
