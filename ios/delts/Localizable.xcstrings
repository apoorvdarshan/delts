          }
        }
      }
    },
    "Subscriptions auto-renew until cancelled. Manage or cancel anytime in your App Store account settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجدد الاشتراكات تلقائيًا حتى الإلغاء. يمكنك الإدارة أو الإلغاء في أي وقت من إعدادات حسابك في App Store."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abunəliklər ləğv edilənədək avtomatik yenilənir. İstənilən vaxt App Store hesab ayarlarında idarə edin və ya ləğv edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abos verlängern sich automatisch bis zur Kündigung. Jederzeit in den App Store-Kontoeinstellungen verwalten oder kündigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente hasta cancelarlas. Gestiónalas o cancélalas cuando quieras en los ajustes de tu cuenta del App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements se renouvellent automatiquement jusqu’à annulation. Gérez ou annulez à tout moment dans les réglages de votre compte App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब्सक्रिप्शन रद्द होने तक अपने-आप रिन्यू होते हैं। App Store अकाउंट सेटिंग्स में कभी भी मैनेज या रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente fino alla disdetta. Gestisci o annulla quando vuoi nelle impostazioni del tuo account App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは解約するまで自動更新されます。App Storeのアカウント設定からいつでも管理・解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 해지할 때까지 자동 갱신됩니다. App Store 계정 설정에서 언제든 관리하거나 해지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnementen worden automatisch verlengd tot opzegging. Beheer of zeg op via je App Store-accountinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subskrypcje odnawiają się automatycznie do momentu anulowania. Zarządzaj nimi lub anuluj w ustawieniach konta App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As assinaturas renovam automaticamente até o cancelamento. Gerencie ou cancele quando quiser nos ajustes da sua conta da App Store."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonamentele se reînnoiesc automat până la anulare. Le gestionezi sau anulezi oricând din configurările contului App Store."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписки продлеваются автоматически до отмены. Управление и отмена — в настройках учётной записи App Store."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅将自动续订，直到取消。可随时在 App Store 账户设置中管理或取消。"
          }
        }
      }
    },
