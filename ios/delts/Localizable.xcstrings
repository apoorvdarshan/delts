    "Add at least one workout to %@ before starting the timer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف تمرينًا واحدًا على الأقل إلى %@ قبل تشغيل المؤقّت."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taymeri başlatmadan əvvəl %@ gününə ən azı bir məşq əlavə edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge %@ mindestens ein Workout hinzu, bevor du den Timer startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade al menos un entrenamiento a %@ antes de iniciar el temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez au moins une séance à %@ avant de lancer le minuteur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइमर शुरू करने से पहले %@ में कम से कम एक वर्कआउट जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi almeno un allenamento a %@ prima di avviare il timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーを開始する前に、%@にワークアウトを1つ以上追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머를 시작하기 전에 %@에 운동을 하나 이상 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg minstens één workout toe aan %@ voordat je de timer start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj co najmniej jeden trening do %@, zanim uruchomisz timer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione pelo menos um treino a %@ antes de iniciar o timer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă cel puțin un antrenament în %@ înainte de a porni cronometrul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте хотя бы одну тренировку в «%@», прежде чем запускать таймер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动计时器前，请先为 %@ 添加至少一个训练。"
          }
        }
      }
    },
