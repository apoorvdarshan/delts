    "Reset filters or search a different body part, machine, or exercise." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد تعيين الفلاتر أو ابحث عن جزء جسم أو جهاز أو تمرين آخر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrləri sıfırlayın və ya başqa bədən hissəsi, trenajor və ya hərəkət axtarın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze die Filter zurück oder suche nach einer anderen Körperpartie, Maschine oder Übung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablece los filtros o busca otra parte del cuerpo, máquina o ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialisez les filtres ou cherchez une autre partie du corps, une machine ou un exercice."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्टर रीसेट करें या कोई और बॉडी पार्ट, मशीन या एक्सरसाइज़ खोजें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reimposta i filtri o cerca un altro gruppo muscolare, macchinario o esercizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィルターをリセットするか、別の部位・マシン・種目で検索してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "필터를 재설정하거나 다른 부위, 머신, 운동을 검색해 보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset de filters of zoek op een ander lichaamsdeel, apparaat of oefening."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zresetuj filtry lub wyszukaj inną partię ciała, maszynę lub ćwiczenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefina os filtros ou busque outra parte do corpo, máquina ou exercício."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetează filtrele sau caută altă grupă musculară, alt aparat sau alt exercițiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
