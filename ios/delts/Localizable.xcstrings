    "Alternate upper-body, lower-body, and core-focused days." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدّل بين أيام الجزء العلوي والجزء السفلي والجذع."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuxarı bədən, aşağı bədən və gövdə yönümlü günləri növbələşdirin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle zwischen Oberkörper-, Unterkörper- und Core-Tagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna días de tren superior, tren inferior y core."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alternez jours haut du corps, bas du corps et tronc."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपर-बॉडी, लोअर-बॉडी और कोर-केंद्रित दिन बारी-बारी रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterna giorni per parte superiore, parte inferiore e core."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上半身・下半身・体幹の日を交互に行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상체, 하체, 코어 중심의 날을 번갈아 구성합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissel dagen af met focus op bovenlichaam, onderlichaam en core."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naprzemiennie dni na górę ciała, dół ciała i core."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterne dias de parte superior, parte inferior e core."
          }
        },
