    "You can rate or review anytime from Settings → About." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك التقييم أو كتابة مراجعة في أي وقت من الإعدادات ← حول."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstənilən vaxt Ayarlar → Haqqında bölməsindən qiymətləndirin və ya rəy yazın."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerten oder rezensieren kannst du jederzeit unter Einstellungen → Über."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes valorar o escribir una reseña cuando quieras desde Ajustes → Acerca de."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ou laissez un avis à tout moment via Réglages → À propos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप सेटिंग्स → जानकारी से कभी भी रेट या रिव्यू कर सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi valutare o recensire quando vuoi da Impostazioni → Informazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評価・レビューは「設定 → アプリについて」からいつでも行えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 정보에서 언제든 평가하거나 리뷰할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beoordelen of een recensie schrijven kan altijd via Instellingen → Over."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocenę lub recenzję możesz wystawić w każdej chwili w Ustawienia → O aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode avaliar quando quiser em Ajustes → Sobre."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poți evalua sau scrie o recenzie oricând din Configurări → Despre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оценить или оставить отзыв можно в любой момент: Настройки → О приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在“设置 → 关于”中评分或评论。"
          }
        }
      }
    },
    "Your choice" : {
