    "Restore failed. Check your connection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت الاستعادة. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bərpa alınmadı. Bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
