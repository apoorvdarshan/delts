    "Stop or discard the %@ timer before starting another." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف مؤقّت %@ أو تجاهله قبل بدء مؤقّت آخر."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yenisini başlatmadan əvvəl %@ taymerini dayandırın və ya ləğv edin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppe oder verwirf den %@-Timer, bevor du einen neuen startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detén o descarta el temporizador de %@ antes de iniciar otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez ou abandonnez le minuteur %@ avant d’en lancer un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरा शुरू करने से पहले %@ टाइमर रोकें या हटाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferma o annulla il timer di %@ prima di avviarne un altro."
